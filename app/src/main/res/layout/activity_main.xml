<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#0F1014">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/overview"
            android:textColor="#A9A9B7"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/perm_overlay"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btn_perm_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open overlay settings"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/perm_a11y"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btn_perm_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open accessibility settings"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/last_coord"
            android:textColor="#A9A9B7"/>
        <TextView
            android:id="@+id/last_coord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#7AE582"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/target_coord"
            android:textColor="#A9A9B7"/>
        <EditText
            android:id="@+id/target_coord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 51,35"
            android:inputType="text"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/start_btn"
            android:backgroundTint="#22A05A"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/stop_btn"
            android:backgroundTint="#A02E2E"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Logs"
            android:textColor="#A9A9B7"/>
        <TextView
            android:id="@+id/logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#C7C7D1"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>

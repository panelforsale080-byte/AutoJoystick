<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/ov_dot"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="#CC22A05A"
        android:gravity="center"
        android:text="AJ"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/ov_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E618181B"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ov_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AutoJoystick"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/ov_minimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="—"
                android:textColor="#FFD54F"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/ov_coord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="coord: —"
            android:textColor="#7AE582"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="target coord"
            android:textColor="#A9A9B7"
            android:textSize="11sp"/>
        <EditText
            android:id="@+id/ov_target"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. 51,35"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F6F7A"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/ov_arrival_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="arrival range: 5 map units"
            android:textColor="#FFD54F"
            android:textSize="11sp"/>

        <SeekBar
            android:id="@+id/ov_arrival"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="0"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/ov_learned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="learned obstacles: 0"
                android:textColor="#7AE582"
                android:textSize="11sp"/>
            <Button
                android:id="@+id/ov_clear_learned"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="CLEAR"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ov_test"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="0.7"
                android:backgroundTint="#8A6D00"
                android:text="TEST"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/ov_cal_joy"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#555566"
                android:text="CAL JOY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/ov_cal_coord"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#6B4DBB"
                android:text="CAL COORD"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/ov_start"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:backgroundTint="#22A05A"
                android:text="START"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/ov_stop"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#A02E2E"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="OCR settings (preview below)"
            android:textColor="#A9A9B7"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="contrast"
            android:textColor="#A9A9B7"
            android:textSize="11sp"/>
        <SeekBar
            android:id="@+id/ov_contrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="250"
            android:progress="130"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="brightness"
            android:textColor="#A9A9B7"
            android:textSize="11sp"/>
        <SeekBar
            android:id="@+id/ov_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="256"
            android:progress="68"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="invert (light→dark)"
                android:textColor="#A9A9B7"
                android:textSize="11sp"/>
            <Switch
                android:id="@+id/ov_invert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#22A05A"
                android:trackTint="#6F6F7A"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ov_preview"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitCenter"
            android:background="#22FFFFFF"
            android:contentDescription="OCR preview crop"/>

        <TextView
            android:id="@+id/ov_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="raw: —"
            android:textColor="#C7C7D1"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/ov_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="idle"
            android:textColor="#A9A9B7"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
